{
  "name": "luajit-2-1-syntax",
  "displayName": "LuaJIT 2.1 Syntax",
  "description": "Adds syntax highlighting for extra LuaJIT keywords and operators.",
  "version": "1.0.0",
  "publisher": "EngineerSmith",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/EngineerSmith/luajit-2-1-syntax"
  },
  "engines": {
    "vscode": "^1.43.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "grammars": [
      {
        "path": "./luajit.json",
        "scopeName": "source.lua.luajit",
        "injectTo": [
          "source.lua"
        ]
      }
    ]
  }
}
